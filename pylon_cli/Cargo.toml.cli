[package]
name = "pylon-cli"
version = "1.0.0"
edition = "2021"
description = "PylonID local development emulator"
license = "MIT"
repository = "https://github.com/pylon-id/pylon"

[[bin]]
name = "pylon-cli"
path = "src/main.rs"

[dependencies]
axum = "0.7"
chrono = { version = "0.4", features = ["serde"] }
reqwest = { version = "0.12", features = ["json"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
tracing = "0.1"
tracing-subscriber = "0.3"
uuid = { version = "1", features = ["v4", "serde"] }
